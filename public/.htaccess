<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # The diagnostic script must never bypass the application profile router.
    RewriteRule ^debug(?:\.php)?/?$ /index.php/debug.php [L]

    # Canonical LLM guidance file (the proposed standard is /llms.txt).
    RewriteRule ^llm\.txt$ /llms.txt [R=301,L,NC]

    # SEO responses are generated by PHP to avoid a stale hard-coded domain.
    RewriteRule ^(robots\.txt|sitemap\.xml)$ /index.php [L]
    
    # Don't rewrite actual files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # Don't process index.php again
    RewriteCond %{REQUEST_URI} ^/index\.php
    RewriteRule ^ - [L]
    
    # Extract action suffix: /path/+download or /path/+open
    RewriteRule ^(.+)\+download/?$ /index.php?path=$1&action=download [L]
    RewriteRule ^(.+)\+open/?$ /index.php?path=$1&action=open [L]
    
    # Rewrite all other requests
    RewriteRule ^(.+)$ /index.php?path=$1 [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "(?i)^(LICENSE|llms\.txt|(?!robots\.txt$).+\.(pdf|md|markdown|txt|csv|tsv|rtf|epub|html|htm|skill|doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp))$">
        Header set X-Robots-Tag "noindex"
    </FilesMatch>
</IfModule>

